	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Build Mousehop.app (release)",
				"type": "shell",
				"command": "scripts/build-macos-release.sh",
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"problemMatcher": [
					"$rustc"
				],
				"presentation": {
					"reveal": "always",
					"panel": "shared",
					"focus": false
				},
				"detail": "Icon → cargo bundle --release → vendor Homebrew dylibs → MousehopDev.app"
			},
			{
				"label": "Build mousehop binary (release)",
				"type": "shell",
				"command": "export PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\"; host=$(rustc -vV | awk '/^host:/{print $2}'); case \"$host\" in aarch64-*) p=/opt/homebrew;; x86_64-*) p=/usr/local;; *) echo \"unsupported rustc host: $host\" >&2; exit 1;; esac; export LIBRARY_PATH=\"$p/lib\" PKG_CONFIG_PATH=\"$p/lib/pkgconfig\" PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$p/bin:$PATH\"; cargo build -p mousehop --release",
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"group": "build",
				"problemMatcher": [
					"$rustc"
				],
				"presentation": {
					"reveal": "always",
					"panel": "shared"
				},
				"detail": "target/release/mousehop (no .app bundle)"
			},
			{
				"label": "Build mousehop.exe (release)",
				"type": "shell",
				"command": "scripts/build-windows-release.ps1",
				"options": {
					"cwd": "${workspaceFolder}",
					"shell": {
						"executable": "powershell.exe",
						"args": [
							"-NoProfile",
							"-ExecutionPolicy",
							"Bypass",
							"-File"
						]
					}
				},
				"group": "build",
				"problemMatcher": [
					"$rustc"
				],
				"presentation": {
					"reveal": "always",
					"panel": "shared",
					"focus": false
				},
				"detail": "README Windows §3–4: GTK env + pkgconf check → cargo build -p mousehop --release → stage exe+DLLs under target/release/mousehop-windows/"
			},
			{
				"label": "Build mousehop (current platform)",
				"type": "shell",
				"command": "cargo build -p mousehop --release",
				"windows": {
					"command": "scripts/build-windows-release.ps1",
					"options": {
						"cwd": "${workspaceFolder}",
						"shell": {
							"executable": "powershell.exe",
							"args": [
								"-NoProfile",
								"-ExecutionPolicy",
								"Bypass",
								"-File"
							]
						}
					}
				},
				"osx": {
					"command": "scripts/build-macos-release.sh",
					"options": {
						"cwd": "${workspaceFolder}"
					}
				},
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"group": "build",
				"problemMatcher": [
					"$rustc"
				],
				"presentation": {
					"reveal": "always",
					"panel": "shared",
					"focus": false
				},
				"detail": "Host OS release: Windows exe staging, macOS .app, else cargo build -p mousehop --release"
			}
		]
	}
